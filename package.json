{
  "name": "dsh-plugin-forge-forgejo",
  "version": "0.1.0",
  "description": "Forgejo provider for the DeepSeek Harness forge registry: pull requests, reviews and checks on Forgejo hosts",
  "keywords": ["dsh-plugin", "deepseek-harness", "forgejo", "gitea", "code-review"],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Iaotle/dsh-plugin-forge-forgejo.git" },
  "engines": { "dsh": ">=0.2.3-alpha.1" },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepare": "pnpm run build",
    "test": "vitest run"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "diff": "^9.0.0",
    "p-limit": "7.3.3",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-experimental-forge": "0.2.3-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-brand": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-experimental-forge": "0.2.3-alpha.2",
    "@types/node": "^24.0.0",
    "tsdown": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  }
}
